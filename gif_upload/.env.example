# 服务监听端口
PORT=8080

# JWT 签名密钥，务必改为随机长字符串，例如: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret

# SQLite 数据库文件路径
DB_PATH=data/app.db

# 单文件大小上限（MB）
MAX_UPLOAD_MB=200

# 车机客户端只读接口的共享密钥，建议随机生成: openssl rand -hex 24
CLIENT_API_KEY=change-me-to-a-random-client-key

# ---- Cloudflare R2 ----
# Cloudflare 账户 ID（仪表盘右侧可见），用于拼接 S3 端点
R2_ACCOUNT_ID=your-account-id
# R2 API 令牌（Dashboard -> R2 -> Manage R2 API Tokens，权限选 Object Read & Write）
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
# 存储桶名称
R2_BUCKET=your-bucket-name

# 可选：直接指定 S3 端点（设置后忽略 R2_ACCOUNT_ID）
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com